{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "pi-arc.sidecar-request.v1",
	"title": "pi-arc sidecar request envelope",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"requestId",
		"type",
		"payload"
	],
	"properties": {
		"schema": {
			"const": "pi-arc.sidecar.v1"
		},
		"requestId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9._~-]+$",
			"minLength": 1
		},
		"type": {
			"type": "string",
			"enum": [
				"open",
				"get_anchor",
				"submit_action",
				"lookup_action",
				"close"
			]
		},
		"payload": {
			"type": "object"
		}
	}
}
