{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "pi-arc.run-result.v1",
	"title": "pi-arc Run result",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"runId",
		"outcomeClass",
		"terminationReason",
		"lastCommittedTurn",
		"artifactRoot",
		"audit"
	],
	"properties": {
		"schema": {
			"const": "pi-arc.run-result.v1"
		},
		"runId": {
			"type": "string",
			"minLength": 1
		},
		"outcomeClass": {
			"type": "string",
			"enum": [
				"win",
				"non_success",
				"unknown_outcome",
				"audit_failure"
			]
		},
		"terminationReason": {
			"type": "string",
			"minLength": 1
		},
		"lastCommittedTurn": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"artifactRoot": {
			"type": "string",
			"minLength": 1
		},
		"audit": {
			"type": "object"
		}
	}
}
