{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "pi-arc.runtime-record.v1",
	"title": "pi-arc runtime record",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"sequence",
		"recordedAt",
		"eventType",
		"payload"
	],
	"properties": {
		"schema": {
			"const": "pi-arc.runtime-record.v1"
		},
		"sequence": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"recordedAt": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
		},
		"eventType": {
			"type": "string",
			"enum": [
				"model.requested",
				"model.responded",
				"tool.completed",
				"tool.rejected",
				"context.boundary"
			]
		},
		"payload": {
			"type": "object"
		}
	}
}
