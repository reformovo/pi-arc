{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "pi-arc.tool-result.v1",
	"title": "pi-arc model tool result",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"invocationId",
		"name",
		"ok"
	],
	"properties": {
		"schema": {
			"const": "pi-arc.tool-result.v1"
		},
		"invocationId": {
			"type": "string",
			"minLength": 1
		},
		"name": {
			"type": "string",
			"enum": [
				"play",
				"inspect",
				"read_pixels",
				"history",
				"read_guide",
				"write_guide",
				"read_working",
				"write_working",
				"save_compact_checkpoint"
			]
		},
		"ok": {
			"type": "boolean"
		},
		"result": {
			"type": "object"
		},
		"error": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"code",
				"message"
			],
			"properties": {
				"code": {
					"type": "string",
					"minLength": 1
				},
				"message": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
