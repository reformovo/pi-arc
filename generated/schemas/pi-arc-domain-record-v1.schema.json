{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "pi-arc.domain-record.v1",
	"title": "pi-arc domain ledger record",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"sequence",
		"recordedAt",
		"recordType",
		"previousDigest",
		"digest",
		"payload"
	],
	"properties": {
		"schema": {
			"const": "pi-arc.domain-record.v1"
		},
		"sequence": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"recordedAt": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
		},
		"recordType": {
			"type": "string",
			"enum": [
				"run.binding",
				"action.intent",
				"environment.receipt",
				"turn.commit",
				"tool.rejection",
				"knowledge.commit",
				"context.boundary",
				"terminal.intent",
				"post_terminal.evidence"
			]
		},
		"previousDigest": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"digest": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"payload": {
			"type": "object"
		}
	}
}
