{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "pi-arc.raw-frame.v1",
	"title": "pi-arc raw frame",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"width",
		"height",
		"pixels",
		"runId",
		"environmentInstanceId",
		"turn",
		"frame",
		"contentDigest"
	],
	"properties": {
		"schema": {
			"const": "pi-arc.raw-frame.v1"
		},
		"width": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"height": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"pixels": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "array",
				"minItems": 1,
				"items": {
					"type": "integer",
					"minimum": 0,
					"maximum": 255
				}
			}
		},
		"runId": {
			"type": "string",
			"minLength": 1
		},
		"environmentInstanceId": {
			"type": "string",
			"minLength": 1
		},
		"turn": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"frame": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"actionId": {
			"type": [
				"string",
				"null"
			]
		},
		"contentDigest": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		}
	}
}
