{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "pi-arc.sidecar-response.v1",
	"title": "pi-arc sidecar response envelope",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"requestId",
		"type",
		"ok"
	],
	"properties": {
		"schema": {
			"const": "pi-arc.sidecar.v1"
		},
		"requestId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9._~-]+$",
			"minLength": 1
		},
		"type": {
			"type": "string",
			"enum": [
				"open",
				"get_anchor",
				"submit_action",
				"lookup_action",
				"close"
			]
		},
		"ok": {
			"type": "boolean"
		},
		"payload": {
			"type": "object"
		},
		"error": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"code",
				"message"
			],
			"properties": {
				"code": {
					"type": "string",
					"enum": [
						"invalid_request",
						"version_mismatch",
						"instance_mismatch",
						"anchor_conflict",
						"action_conflict",
						"unavailable",
						"internal"
					]
				},
				"message": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
