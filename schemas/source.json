{
	"sourceVersion": 1,
	"schemas": [
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.cli-event.v1",
			"title": "pi-arc CLI event",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "sequence", "occurredAt", "runId", "type", "data"],
			"properties": {
				"schema": { "const": "pi-arc.cli-event.v1" },
				"sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
				"occurredAt": {
					"type": "string",
					"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
				},
				"runId": { "type": ["string", "null"] },
				"type": {
					"type": "string",
					"enum": [
						"run.started",
						"run.resumed",
						"model.requested",
						"model.responded",
						"tool.completed",
						"tool.rejected",
						"action.intent",
						"environment.receipt",
						"turn.committed",
						"context.boundary",
						"audit.finding",
						"audit.completed",
						"run.completed",
						"run.rejected"
					]
				},
				"data": { "type": "object" }
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.run-manifest.v1",
			"title": "pi-arc Run manifest",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "runId", "game", "model", "runtime", "coordinates", "seed", "config"],
			"properties": {
				"schema": { "const": "pi-arc.run-manifest.v1" },
				"runId": { "type": "string", "minLength": 1 },
				"game": {
					"type": "object",
					"additionalProperties": false,
					"required": ["id", "sourceLocator", "treeDigest"],
					"properties": {
						"id": { "type": "string", "pattern": "^[a-z0-9]{4}-[0-9a-f]{8}$" },
						"sourceLocator": { "type": "string", "minLength": 1 },
						"treeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
					}
				},
				"model": {
					"type": "object",
					"additionalProperties": false,
					"required": ["provider", "modelId"],
					"properties": {
						"provider": { "type": "string", "minLength": 1 },
						"modelId": { "type": "string", "minLength": 1 },
						"thinkingLevel": {
							"type": "string",
							"enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
						}
					}
				},
				"runtime": {
					"type": "object",
					"additionalProperties": false,
					"required": ["piAgentCore", "piAi"],
					"properties": {
						"piAgentCore": { "type": "string", "const": "0.86.0" },
						"piAi": { "type": "string", "const": "0.86.0" }
					}
				},
				"coordinates": { "type": "integer", "const": 1024 },
				"seed": { "type": "integer", "const": 42 },
				"config": {
					"type": "object",
					"additionalProperties": false,
					"required": ["actionBudget", "gameOffline"],
					"properties": {
						"actionBudget": { "type": "integer", "minimum": 1, "maximum": 999999 },
						"gameOffline": { "type": "boolean" }
					}
				}
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.game-cache.v1",
			"title": "pi-arc Game cache manifest",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema",
				"sourceLocator",
				"gameId",
				"sdkVersion",
				"runtimeVersion",
				"seed",
				"treeDigest",
				"entries"
			],
			"properties": {
				"schema": { "const": "pi-arc.game-cache.v1" },
				"sourceLocator": {
					"type": "string",
					"pattern": "^arc-agi://public/[a-z0-9]{4}-[0-9a-f]{8}\\?sdk=0\\.9\\.9$"
				},
				"gameId": { "type": "string", "pattern": "^[a-z0-9]{4}-[0-9a-f]{8}$" },
				"sdkVersion": { "const": "0.9.9" },
				"runtimeVersion": { "const": "3.12.9" },
				"seed": { "type": "integer", "const": 42 },
				"treeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"entries": {
					"type": "array",
					"minItems": 2,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["path", "size", "sha256"],
						"properties": {
							"path": {
								"type": "string",
								"pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
							},
							"size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
							"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
						}
					}
				}
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.domain-record.v1",
			"title": "pi-arc domain ledger record",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "sequence", "recordedAt", "recordType", "previousDigest", "digest", "payload"],
			"properties": {
				"schema": { "const": "pi-arc.domain-record.v1" },
				"sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
				"recordedAt": {
					"type": "string",
					"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
				},
				"recordType": {
					"type": "string",
					"enum": [
						"run.binding",
						"action.intent",
						"environment.receipt",
						"turn.commit",
						"tool.rejection",
						"knowledge.commit",
						"context.boundary",
						"terminal.intent",
						"post_terminal.evidence"
					]
				},
				"previousDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"payload": { "type": "object" }
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.runtime-record.v1",
			"title": "pi-arc runtime record",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "sequence", "recordedAt", "eventType", "payload"],
			"properties": {
				"schema": { "const": "pi-arc.runtime-record.v1" },
				"sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
				"recordedAt": {
					"type": "string",
					"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
				},
				"eventType": {
					"type": "string",
					"enum": ["model.requested", "model.responded", "tool.completed", "tool.rejected", "context.boundary"]
				},
				"payload": { "type": "object" }
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.raw-frame.v1",
			"title": "pi-arc raw frame",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema",
				"width",
				"height",
				"pixels",
				"runId",
				"environmentInstanceId",
				"turn",
				"frame",
				"contentDigest"
			],
			"properties": {
				"schema": { "const": "pi-arc.raw-frame.v1" },
				"width": { "type": "integer", "minimum": 1, "maximum": 64 },
				"height": { "type": "integer", "minimum": 1, "maximum": 64 },
				"pixels": {
					"type": "array",
					"minItems": 1,
					"maxItems": 64,
					"items": {
						"type": "array",
						"minItems": 1,
						"maxItems": 64,
						"items": { "type": "integer", "minimum": 0, "maximum": 15 }
					}
				},
				"runId": { "type": "string", "minLength": 1 },
				"environmentInstanceId": { "type": "string", "minLength": 1 },
				"turn": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"frame": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"actionId": { "type": ["string", "null"] },
				"contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.terminal.v1",
			"title": "pi-arc terminal record",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema",
				"runId",
				"outcomeClass",
				"terminationReason",
				"lastCommittedTurn",
				"ledgerHead",
				"recordedAt"
			],
			"properties": {
				"schema": { "const": "pi-arc.terminal.v1" },
				"runId": { "type": "string", "minLength": 1 },
				"outcomeClass": { "type": "string", "enum": ["win", "non_success", "unknown_outcome", "audit_failure"] },
				"terminationReason": {
					"type": "string",
					"enum": [
						"WIN",
						"action_budget_exhausted",
						"model_failure",
						"model_no_progress",
						"checkpoint_failed",
						"environment_lost",
						"evidence_incomplete",
						"evidence_corrupt",
						"unknown_action_outcome",
						"cancelled",
						"controller_failure"
					]
				},
				"lastCommittedTurn": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"ledgerHead": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"recordedAt": {
					"type": "string",
					"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
				}
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.audit.v1",
			"title": "pi-arc audit result",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "runId", "ok", "manifestDigest", "ledgerHead", "findings"],
			"properties": {
				"schema": { "const": "pi-arc.audit.v1" },
				"runId": { "type": "string", "minLength": 1 },
				"ok": { "type": "boolean" },
				"manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"ledgerHead": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"findings": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["code", "severity", "message"],
						"properties": {
							"code": { "type": "string", "minLength": 1 },
							"severity": { "type": "string", "enum": ["info", "error"] },
							"message": { "type": "string", "minLength": 1 }
						}
					}
				}
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.sidecar-request.v1",
			"title": "pi-arc sidecar request envelope",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "requestId", "type", "payload"],
			"properties": {
				"schema": { "const": "pi-arc.sidecar.v1" },
				"requestId": { "type": "string", "pattern": "^[A-Za-z0-9._~-]+$", "minLength": 1 },
				"type": { "type": "string", "enum": ["open", "get_anchor", "submit_action", "lookup_action", "close"] },
				"payload": { "type": "object" }
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.sidecar-response.v1",
			"title": "pi-arc sidecar response envelope",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "requestId", "type", "ok"],
			"properties": {
				"schema": { "const": "pi-arc.sidecar.v1" },
				"requestId": { "type": "string", "pattern": "^[A-Za-z0-9._~-]+$", "minLength": 1 },
				"type": { "type": "string", "enum": ["open", "get_anchor", "submit_action", "lookup_action", "close"] },
				"ok": { "type": "boolean" },
				"payload": { "type": "object" },
				"error": {
					"type": "object",
					"additionalProperties": false,
					"required": ["code", "message"],
					"properties": {
						"code": {
							"type": "string",
							"enum": [
								"invalid_request",
								"version_mismatch",
								"instance_mismatch",
								"anchor_conflict",
								"action_conflict",
								"unavailable",
								"internal"
							]
						},
						"message": { "type": "string", "minLength": 1 }
					}
				}
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.tool-call.v1",
			"title": "pi-arc model tool call",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "invocationId", "name", "args"],
			"properties": {
				"schema": { "const": "pi-arc.tool-call.v1" },
				"invocationId": { "type": "string", "minLength": 1 },
				"name": {
					"type": "string",
					"enum": [
						"play",
						"inspect",
						"read_pixels",
						"history",
						"read_guide",
						"write_guide",
						"read_working",
						"write_working",
						"save_compact_checkpoint"
					]
				},
				"args": { "type": "object" }
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.tool-result.v1",
			"title": "pi-arc model tool result",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "invocationId", "name", "ok"],
			"properties": {
				"schema": { "const": "pi-arc.tool-result.v1" },
				"invocationId": { "type": "string", "minLength": 1 },
				"name": {
					"type": "string",
					"enum": [
						"play",
						"inspect",
						"read_pixels",
						"history",
						"read_guide",
						"write_guide",
						"read_working",
						"write_working",
						"save_compact_checkpoint"
					]
				},
				"ok": { "type": "boolean" },
				"result": { "type": "object" },
				"error": {
					"type": "object",
					"additionalProperties": false,
					"required": ["code", "message"],
					"properties": {
						"code": { "type": "string", "minLength": 1 },
						"message": { "type": "string", "minLength": 1 }
					}
				}
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.run-result.v1",
			"title": "pi-arc Run result",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema",
				"runId",
				"outcomeClass",
				"terminationReason",
				"lastCommittedTurn",
				"artifactRoot",
				"audit"
			],
			"properties": {
				"schema": { "const": "pi-arc.run-result.v1" },
				"runId": { "type": "string", "minLength": 1 },
				"outcomeClass": { "type": "string", "enum": ["win", "non_success", "unknown_outcome", "audit_failure"] },
				"terminationReason": { "type": "string", "minLength": 1 },
				"lastCommittedTurn": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"artifactRoot": { "type": "string", "minLength": 1 },
				"audit": { "type": "object" }
			}
		},
		{
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"$id": "pi-arc.audit-result.v1",
			"title": "pi-arc SDK audit result",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema", "ok", "runId", "manifestDigest", "ledgerHead", "findings"],
			"properties": {
				"schema": { "const": "pi-arc.audit-result.v1" },
				"ok": { "type": "boolean" },
				"runId": { "type": ["string", "null"] },
				"manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"ledgerHead": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"findings": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["code", "severity", "message"],
						"properties": {
							"code": { "type": "string", "minLength": 1 },
							"severity": { "type": "string", "enum": ["info", "error"] },
							"message": { "type": "string", "minLength": 1 }
						}
					}
				}
			}
		}
	]
}
